{
  "name": "shotx-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/js/*.test.js",
    "test:stress": "node --test tests/js/stress.test.js",
    "test:unity": "dotnet test tests/dotnet/Shotx.Tests/Shotx.Tests.csproj",
    "build:unity-deps": "node scripts/build-unity-deps.mjs",
    "pack:npm": "node scripts/prepare-npm.mjs && npm pack ./packages/shotx",
    "benchmark": "node benchmark/run.js",
    "test:browser:server": "node demo/room-reconnect-server.js",
    "test:browser:ui": "npm --prefix demo run dev -- --host 127.0.0.1"
  },
  "devDependencies": {
    "shotx": "workspace:*",
    "socket.io-client": "^4.8.3"
  },
  "packageManager": "pnpm@11.9.0"
}
